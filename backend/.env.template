# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ── Secrets (generate with: openssl rand -base64 32) ─────────────────────────
JWT_SECRET=generate_a_long_random_string_here
COOKIE_SECRET=generate_another_long_random_string_here

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Key ID and Secret: Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Webhook Secret: a string YOU choose when adding a webhook in Dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=your_chosen_webhook_secret
# Note: RAZORPAY_ACCOUNT (Merchant ID) is NOT required for a standard store.
# It is only used for Razorpay Route marketplace payouts.

# ── CORS ─────────────────────────────────────────────────────────────────────
# Local dev: http://localhost:3000
# Production: https://your-store.vercel.app
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7001
